<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Only NSAllowsArbitraryLoads: when NSAllowsLocalNetworking (or the other NSAllowsArbitraryLoads*
	keys) is also present, macOS ignores NSAllowsArbitraryLoads and blocks plain http:// to the internet.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!--
	Return freed large blocks (response bodies, formatted text) to the system immediately instead of
	caching them, so memory drops back after closing tabs or replacing big responses. Applied by
	LaunchServices when the app is launched from Finder, the Dock or `open`.
	-->
	<key>LSEnvironment</key>
	<dict>
		<key>MallocLargeCache</key>
		<string>0</string>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>PostData needs local network access to send requests to servers on your network.</string>
</dict>
</plist>
